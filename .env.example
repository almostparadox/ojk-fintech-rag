# LLM Provider Configuration
# Works out-of-the-box with any OpenAI-compatible provider:
# OpenAI, DeepSeek, 9router, OpenRouter, Groq, Ollama, etc.

# Option 1: Standard / Generic LLM
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Option 2: 9router
# LLM_API_KEY=your_9router_key_here
# LLM_BASE_URL=https://api.9router.com/v1
# DEFAULT_MODEL=deepseek-chat

# Option 3: DeepSeek
# LLM_API_KEY=your_deepseek_key_here
# LLM_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL=deepseek-chat

# Option 4: Local Ollama (100% offline, zero API cost)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=qwen2.5:7b

# (Legacy aliases OPENAI_API_KEY and NINEROUTER_API_KEY are also supported)

# Local Embeddings & Storage
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STORAGE_DIR=./storage
