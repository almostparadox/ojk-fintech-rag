# LLM Provider Configuration
# Works out-of-the-box with any OpenAI-compatible provider:
# OpenAI, DeepSeek, OpenRouter, Groq, Ollama, etc.

# Option 1: Standard OpenAI / OpenAI-compatible API
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Option 2: DeepSeek
# LLM_API_KEY=your_deepseek_key_here
# LLM_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL=deepseek-chat

# Option 3: OpenRouter
# LLM_API_KEY=your_openrouter_key_here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=deepseek/deepseek-chat

# Option 4: Local Ollama (100% offline, zero API cost)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=qwen2.5:7b

# (OPENAI_API_KEY is also supported as an alias)

# Local Embeddings & Storage
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STORAGE_DIR=./storage
